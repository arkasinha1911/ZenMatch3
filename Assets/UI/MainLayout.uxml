                <engine:Button name="retryButton" text="Retry" class="standard-button" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Merienda-Medium.ttf?fileID=12800000&amp;guid=e2c922161a0ed3143804a9560504f48e&amp;type=3#Merienda-Medium&quot;); font-size: 40px; color: rgb(7, 33, 84);"/>
                <engine:Button name="loseMenuButton" text="Main Menu" class="standard-button" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Merienda-Medium.ttf?fileID=12800000&amp;guid=e2c922161a0ed3143804a9560504f48e&amp;type=3#Merienda-Medium&quot;); font-size: 45px; color: rgb(7, 33, 84);"/>
