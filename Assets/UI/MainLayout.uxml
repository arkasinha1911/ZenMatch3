                <engine:Button name="btnMagnet" text="" icon-image="" class="standard-button" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Merienda-Medium.ttf?fileID=12800000&amp;guid=e2c922161a0ed3143804a9560504f48e&amp;type=3#Merienda-Medium&quot;); font-size: 76px; margin: 0 8px; height: 100px; width: 250px; color: rgb(7, 33, 84); flex-direction: column; padding: 5px; background-image: url(&quot;project://database/Assets/Data/Sprites/Magnet.png?fileID=2800000&amp;guid=5985da70a4dfc064c92262bec621c8d1&amp;type=3#Magnet&quot;); background-size: 43% 100%; background-position-x: right 0; background-position-y: center;">
