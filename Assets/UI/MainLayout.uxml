                        <engine:Label text="Clears all objective pieces instantly" class="shop-card-desc" style="-unity-font-definition: url(&quot;project://database/Assets/TextMesh%20Pro/Examples%20&amp;%20Extras/Fonts/Merienda-Medium.ttf?fileID=12800000&amp;guid=e2c922161a0ed3143804a9560504f48e&amp;type=3#Merienda-Medium&quot;); font-size: 30px;"/>
