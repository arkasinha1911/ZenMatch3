/* Main aesthetic for ZenMatch3 */
:root {
    -unity-font-definition: initial;
    /* Use dynamic pastel colors that match our Zen vibe */
    --background-color: #f7f3ed;
    --panel-background: rgba(255, 255, 255, 0.85);
    --button-background: #aec5eb;
    --button-hover: #98b3de;
    --button-active: #82a0cc;
    --button-disabled: #d8dee8;
    --text-color: #2c3e50;
    --border-radius: 15px;
}

.fullscreen-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--background-color);
}

.transparent-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.modal-box {
    background-color: var(--panel-background);
    border-radius: var(--border-radius);
    padding: 40px;
    align-items: center;
    box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.1);
}

.title-text {
    font-size: 64px;
    -unity-font-style: bold;
    color: var(--text-color);
    margin-bottom: 40px;
}

.heading-text {
    font-size: 36px;
    -unity-font-style: bold;
    color: var(--text-color);
    margin-bottom: 20px;
}

.standard-button {
    background-color: var(--button-background);
    border-radius: var(--border-radius);
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    padding: 15px 40px;
    border-width: 0;
    margin: 10px;
    transition: scale 0.1s;
}

.standard-button:hover {
    background-color: var(--button-hover);
    scale: 1.05;
}

.standard-button:active {
    background-color: var(--button-active);
    scale: 0.95;
}

.standard-button:disabled {
    background-color: var(--button-disabled);
    color: rgba(255,255,255,0.5);
}

.hud-container {
    position: absolute;
    top: 20px;
    left: 20px;
    right: 20px;
    flex-direction: row;
    justify-content: space-between;
}

.timer-text {
    font-size: 32px;
    -unity-font-style: bold;
    color: white;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}

.target-list {
    flex-direction: row;
}

/* --- PREMIUM HUD STYLING --- */
.hud-glass-bar {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    background-color: rgba(255, 255, 255, 0.3);
    border-bottom-left-radius: 30px;
    border-bottom-right-radius: 30px;
    border-bottom-width: 5px;
    border-color: rgba(255, 255, 255, 0.7);
    padding: 15px 30px;
}

.pill-badge-gold {
    background-color: #ffc233;
    border-radius: 30px;
    padding: 10px 35px;
    margin: 5px;
    border-width: 4px;
    border-color: #e6a817;
    align-items: center;
}

.pill-badge-blue {
    background-color: #6bb9ff;
    border-radius: 30px;
    padding: 10px 35px;
    margin: 5px;
    border-width: 4px;
    border-color: #4a9eeb;
    align-items: center;
}

.pill-badge-red {
    background-color: #ff6b6b;
    border-radius: 20px;
    padding: 5px 20px;
    margin: 5px;
    border-width: 3px;
    border-color: #e55050;
    align-items: center;
}

.hud-value-text {
    font-size: 45px;
    color: white;
    -unity-font-style: bold;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.3);
}

/* Individual Objective Layout */
.objective-container {
    flex-direction: row;
    align-items: center;
    background-color: var(--panel-background);
    border-radius: 10px;
    padding: 5px 15px;
    margin-left: 10px;
}

.objective-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
}

.objective-text {
    font-size: 20px;
    color: var(--text-color);
    -unity-font-style: bold;
}

/* Level Button specific css */
.level-button {
    width: 200px;
    height: 100px;
}

.level-button-text {
    font-size: 24px;
    -unity-font-style: bold;
}

.level-button-score {
    font-size: 14px;
    margin-top: 5px;
}

/* --- SHOP UI --- */
.shop-header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 15px;
    padding: 8px 25px;
    background-color: rgba(255, 215, 0, 0.15);
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(255, 215, 0, 0.4);
}

.shop-card-row {
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    margin-bottom: 15px;
    flex-wrap: wrap;
}

.shop-card {
    width: 220px;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 18px;
    padding: 15px;
    margin: 8px;
    align-items: center;
    border-width: 3px;
    border-color: rgba(0, 0, 0, 0.08);
    transition: scale 0.1s;
}

.shop-card:hover {
    scale: 1.03;
    border-color: rgba(0, 0, 0, 0.15);
}

.shop-card-magnet {
    border-color: #e74c3c;
    background-color: rgba(231, 76, 60, 0.08);
}

.shop-card-xbomb {
    border-color: #3498db;
    background-color: rgba(52, 152, 219, 0.08);
}

.shop-card-areabomb {
    border-color: #2ecc71;
    background-color: rgba(46, 204, 113, 0.08);
}

.shop-card-icon {
    font-size: 50px;
    -unity-text-align: middle-center;
    margin-bottom: 5px;
}

.shop-card-title {
    font-size: 28px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 3px;
}

.shop-card-desc {
    font-size: 16px;
    color: rgba(0, 0, 0, 0.5);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    white-space: normal;
}

.shop-card-owned {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgba(0, 0, 0, 0.4);
    margin-bottom: 8px;
}

.shop-buy-button {
    background-color: #ffc233;
    border-radius: 12px;
    color: rgb(7, 33, 84);
    font-size: 22px;
    -unity-font-style: bold;
    padding: 8px 20px;
    border-width: 0;
    margin: 0;
    transition: scale 0.1s;
    width: 90%;
}

.shop-buy-button:hover {
    background-color: #e6a817;
    scale: 1.05;
}

.shop-buy-button:active {
    background-color: #cc9410;
    scale: 0.95;
}

.shop-feedback {
    font-size: 22px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 5px;
    height: 30px;
}
